{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "canvas_canvas_draw", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_pen", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_script", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_clear", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_annotate", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_emphasis", "resource": "*", "effect": "deny" },
    { "action": "canvas_canvas_tidy", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "canvas": {
        "type": "remote",
        "url": "http://127.0.0.1:5173/mcp",
        "oauth": false,
        "timeout": {
          "catalog": 45000
        }
      }
    }
  }
}
